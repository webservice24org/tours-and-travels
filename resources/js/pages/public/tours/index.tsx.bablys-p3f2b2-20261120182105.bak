import { Head } from '@inertiajs/react';

type TourCard = {
    id: number;
    title: string;
    slug: string;
    summary: string | null;
    duration_days: number;
    is_featured: boolean;
};

type Filters = {
    category: string;
    destination: string;
    q: string;
    sort: 'featured' | 'title_asc' | 'duration_asc' | 'duration_desc';
};

type FilterOption = { slug: string; name: string };

type Pagination = {
    page: number;
    per_page: number;
    last_page: number;
    total: number;
    has_previous: boolean;
    has_next: boolean;
};

type Props = {
    tours: TourCard[];
    filters: Filters;
    filter_options: { categories: FilterOption[]; destinations: FilterOption[] };
    pagination: Pagination;
    result_limit: number;
};

const inputClass =
    'mt-1 block w-full min-w-0 rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-slate-900 focus:border-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-200';

function pageHref(filters: Filters, page: number): string {
    const params = new URLSearchParams();
    if (filters.category) params.set('category', filters.category);
    if (filters.destination) params.set('destination', filters.destination);
    if (filters.q) params.set('q', filters.q);
    if (filters.sort !== 'featured') params.set('sort', filters.sort);
    if (page > 1) params.set('page', String(page));
    const query = params.toString();

    return query ? `/tours?${query}` : '/tours';
}

/** P3F.2B.1 SQL-backed published-only listing. No invented booking or price claims. */
export default function PublicTourIndex({ tours, filters, filter_options, pagination }: Props) {
    const start = pagination.total === 0 ? 0 : (pagination.page - 1) * pagination.per_page + 1;
    const end = pagination.total === 0 ? 0 : start + tours.length - 1;
    const hasFilters = Boolean(filters.q || filters.category || filters.destination || filters.sort !== 'featured');

    return (
        <main className="min-h-screen min-w-0 overflow-x-clip bg-slate-50 text-slate-900">
            <Head title="Find Tours | Bablys Tours & Travels">
                <meta name="description" content="Search published tour experiences from Bablys Tours & Travels." />
            </Head>
            <section className="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
                <div className="max-w-3xl">
                    <p className="text-sm font-semibold uppercase tracking-wide text-teal-800">Discover journeys</p>
                    <h1 className="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Explore our tours</h1>
                    <p className="mt-3 text-base leading-7 text-slate-600">
                        Browse published experiences. Prices, departures and availability are subject to confirmation.
                    </p>
                </div>

                <form method="get" action="/tours" role="search" aria-label="Search published tours"
                    className="mt-8 grid min-w-0 gap-4 rounded-xl border border-slate-200 bg-white p-4 sm:grid-cols-2 lg:grid-cols-4">
                    <label className="min-w-0 text-sm font-semibold text-slate-700">
                        Search tours
                        <input name="q" type="search" maxLength={80} defaultValue={filters.q}
                            placeholder="Name or summary" className={inputClass} />
                    </label>
                    <label className="min-w-0 text-sm font-semibold text-slate-700">
                        Category slug
                        <input name="category" type="text" list="published-tour-categories"
                            pattern="[a-z0-9]+(-[a-z0-9]+)*" maxLength={120}
                            defaultValue={filters.category} placeholder="Choose or type a slug" className={inputClass} />
                        <datalist id="published-tour-categories">
                            {filter_options.categories.map((option) => (
                                <option key={option.slug} value={option.slug} label={option.name} />
                            ))}
                        </datalist>
                    </label>
                    <label className="min-w-0 text-sm font-semibold text-slate-700">
                        Destination slug
                        <input name="destination" type="text" list="published-tour-destinations"
                            pattern="[a-z0-9]+(-[a-z0-9]+)*" maxLength={120}
                            defaultValue={filters.destination} placeholder="Choose or type a slug" className={inputClass} />
                        <datalist id="published-tour-destinations">
                            {filter_options.destinations.map((option) => (
                                <option key={option.slug} value={option.slug} label={option.name} />
                            ))}
                        </datalist>
                    </label>
                    <label className="min-w-0 text-sm font-semibold text-slate-700">
                        Sort by
                        <select name="sort" defaultValue={filters.sort} className={inputClass}>
                            <option value="featured">Featured first</option>
                            <option value="title_asc">Title A–Z</option>
                            <option value="duration_asc">Shortest duration</option>
                            <option value="duration_desc">Longest duration</option>
                        </select>
                    </label>
                    <div className="flex min-w-0 flex-wrap items-center gap-3 sm:col-span-2 lg:col-span-4">
                        <button type="submit" className="rounded-lg bg-teal-800 px-5 py-2.5 font-semibold text-white hover:bg-teal-900 focus:outline-none focus:ring-2 focus:ring-teal-600 focus:ring-offset-2">
                            Apply filters
                        </button>
                        {hasFilters && <a href="/tours" className="font-semibold text-teal-800 underline underline-offset-2 focus:outline-none focus:ring-2 focus:ring-teal-600">Clear filters</a>}
                    </div>
                </form>

                <div className="mt-8 flex flex-wrap items-center justify-between gap-2 text-sm text-slate-600" role="status" aria-live="polite">
                    <span>Showing {start}–{end} of {pagination.total} matching published tours</span>
                    <span>Page {pagination.page} of {pagination.last_page}</span>
                </div>

                {tours.length === 0 ? (
                    <div className="mt-6 rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center">
                        <h2 className="text-lg font-semibold">No matching published tours</h2>
                        <p className="mt-2 text-slate-600">Try another search, category or destination.</p>
                    </div>
                ) : (
                    <ul className="mt-6 grid min-w-0 list-none gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3">
                        {tours.map((tour) => (
                            <li key={tour.id} className="min-w-0 overflow-hidden rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
                                {tour.is_featured && <span className="inline-block rounded-full bg-teal-50 px-3 py-1 text-xs font-semibold text-teal-900">Featured</span>}
                                <h2 className="mt-3 break-words text-xl font-semibold leading-snug">{tour.title}</h2>
                                <p className="mt-2 text-sm font-medium text-slate-600">
                                    {tour.duration_days} {tour.duration_days === 1 ? 'day' : 'days'}
                                </p>
                                {tour.summary && <p className="mt-3 break-words text-sm leading-6 text-slate-700">{tour.summary}</p>}
                            </li>
                        ))}
                    </ul>
                )}

                {pagination.last_page > 1 && (
                    <nav aria-label="Tour results pagination" className="mt-8 flex flex-wrap items-center justify-between gap-3">
                        {pagination.has_previous ? (
                            <a href={pageHref(filters, pagination.page - 1)} rel="prev"
                                className="rounded-lg border border-teal-800 px-4 py-2 font-semibold text-teal-800 hover:bg-teal-50 focus:outline-none focus:ring-2 focus:ring-teal-600">Previous</a>
                        ) : <span aria-hidden="true" />}
                        <span className="text-sm text-slate-600">Page {pagination.page} of {pagination.last_page}</span>
                        {pagination.has_next ? (
                            <a href={pageHref(filters, pagination.page + 1)} rel="next"
                                className="rounded-lg border border-teal-800 px-4 py-2 font-semibold text-teal-800 hover:bg-teal-50 focus:outline-none focus:ring-2 focus:ring-teal-600">Next</a>
                        ) : <span aria-hidden="true" />}
                    </nav>
                )}

                <p className="mt-6 text-xs leading-5 text-slate-500">
                    Results are paginated across the full published catalog, not a 50-tour window.
                    Submitting a booking request does not reserve seats or confirm availability.
                </p>
            </section>
        </main>
    );
}
